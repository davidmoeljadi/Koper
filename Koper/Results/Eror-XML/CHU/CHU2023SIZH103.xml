Pendidikan di Indonesia terbagi menjadi empat <segment id='1' features='eror;leksikal;kata;noms' state='active' correction='jenjang'>bagian</segment>, <segment id='2' features='eror;gramatikal;frasa-verba;vrbx' state='active'><segment id='3' features='eror;gramatikal;konjungsi;konj0' state='active' correction='yaitu' parent='2'>ada</segment></segment> <segment id='4' features='eror;ejaan;ejtb' state='active' comment='Kekurangan tanda koma' correction='SD, SMP, SMA, dan'>SD SMP SMA dan</segment> universitas. <segment id='5' features='eror;leksikal;ungkapan;ukps' state='active'>SD dan SMP bebas, lalu harus dipergi.</segment> <segment id='6' features='eror;leksikal;kata;noms' state='active' correction='Biayanya'>Harganya</segment> lebih murah <segment id='7' features='eror;gramatikal;frasa-preposisi;prep0' state='active' correction='di'>daripada Jepang</segment>, tetapi tidak murah untuk orang Indonesia. <segment id='30' features='eror;gramatikal;kalimat;kalpen' state='active' correction='Sekolah Indonesia menekankan pendidikan Islam sehingga semua orang wajib berdoa pada hari Jumat'>Sekolah Indonesia menekankan pendidikan Islam. Semua orang berdoa pada hari <segment id='9' features='eror;ejaan;ejsp' state='active' comment='Kelebihan spasi' correction='Jumat' parent='30'>Jumat .</segment></segment> <segment id='8' features='eror;gramatikal;frasa-nomina;nomx' state='active'>Waktu</segment> <segment id='10' features='eror;gramatikal;frasa-verba;vrb0' state='active' correction='berlangsung'>kelas dari</segment> <segment id='11' features='eror;ejaan;ejk' state='active' correction='jam'>Jam</segment> 7 seperempat <segment id='13' features='eror;leksikal;kata;preps' state='active' correction='sampai'>ke</segment> <segment id='12' features='eror;ejaan;ejk' state='active' correction='jam'>Jam</segment> setengah 1. <segment id='16' features='eror;gramatikal;kalimat;kalpen' state='active' correction='Di sekolah Indonesia, tidak ada makan siang sehingga siswa makan di rumah.'>Di sekolah Indonesia tidak ada makan siang. Siswa makan di rumah.</segment> Universitas adalah <segment id='14' features='eror;gramatikal;frasa-verba;vrb0' state='active' correction='belajar'>program 4</segment> tahun. Universitas terkenal misalnya Universitas Gadjah <segment id='19' features='eror;ejaan;ejtb' state='active' correction=','>Mada Universitas</segment> <segment id='20' features='eror;ejaan;ejtb' state='active' correction=','>Indonesia dan</segment> Universitas Diponegoro. <segment id='21' features='eror;leksikal;kata;noms' state='active' correction='Dosen'>Guru</segment> bahasa Indonesia <segment id='23' features='eror;gramatikal;frasa-adverbia;adv0' state='active' correction='pernah'><segment id='22' features='eror;ejaan;ejk' state='active' correction='saya' parent='23'>Saya</segment> belajar</segment> di <segment id='24' features='eror;ejaan;ejk' state='active' correction='Universitas'>universitas</segment> Gadjah Mada.
Saya mau pergi ke <segment id='15' features='eror;ejaan;ejtb' state='active'>Indonesia lalu</segment> <segment id='26' features='eror;gramatikal;frasa-verba;vrbx' state='active'>mau</segment> <segment id='27' features='eror;leksikal;kata;vrbs' state='active' correction='berkunjung'>pergi</segment> ke kampus <segment id='29' features='eror;ejaan;ejk' state='active' correction='Universitas'>universitas</segment> Gadjah Mada.    </body>
