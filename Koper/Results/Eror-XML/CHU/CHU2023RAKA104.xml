<segment id='1' features='eror;ejaan;ejsp' state='active'>Namanya  [NAMA]</segment> <segment id='2' features='eror;ejaan;ejsp' state='active'>[NAMA].<segment id='15' features='eror;leksikal;kata;ktvar' state='active'>Dia</segment> berasal dari <segment id='3' features='eror;ejaan;ejsp' state='active' parent='15'>Sendai.Dia</segment> tinggal di Tokyo.
Dia punya adik <segment id='18' features='eror;ejaan;ejhrf' state='active' correction='perempuan' parent='15'>perempuna</segment> dan adik laki-laki.</segment> <segment id='25' features='eror;ejaan;ejhrf' state='active'>Meraka</segment> tinggal di <segment id='4' features='eror;ejaan;ejsp' state='active'>Sendai.<segment id='16' features='eror;leksikal;kata;ktvar' state='active'>Dia</segment> tinggal di Tokyo <segment id='5' features='eror;ejaan;ejsp' state='active' parent='16'>sekarang.Dia</segment> <segment id='19' features='eror;leksikal;kata;noms' state='active' correction='siswa' parent='16'>mahasiswa</segment> di SMA.
Dia bangun tepat jam 7:30 tadi <segment id='6' features='eror;ejaan;ejsp' state='active' parent='16'>pagi.Dia</segment> makan panekuk dan <segment id='7' features='eror;ejaan;ejsp' state='active' parent='16'>salad.Dia</segment> minum jus <segment id='8' features='eror;ejaan;ejsp' state='active'>jeruk.</segment>Sekolah</segment> <segment id='21' features='eror;gramatikal;frasa-nomina;nyaitu' state='active'>itu</segment> bersebelahan dengan <segment id='9' features='eror;ejaan;ejsp' state='active'>supermarket.Dia</segment> belajar bahasa <segment id='10' features='eror;ejaan;ejk' state='active' correction='Inggris'>inggris</segment>. 
<segment id='24' features='eror;leksikal;kata;ktvar' state='active'><segment id='22' features='eror;lainnya;lain' state='active' comment='Kalimat pembahasan sebelumnya tidak padu dengan kalimat ini maupun dengan kalimat setelahnya.' parent='24'>Adikku tidak pandai <segment id='11' features='eror;ejaan;ejsp' state='active' parent='24'>matematika.</segment>Adik</segment> laki-laki <segment id='26' features='eror;leksikal;kata;prons' state='active' parent='24'>saya</segment> pandai dalam <segment id='23' features='eror;leksikal;kata;noms' state='active' correction='ilmu pengetahuan sosial' parent='24'>masyarakat</segment>.
Adik <segment id='20' features='eror;gramatikal;frasa-nomina;pron0' state='active' parent='24'>laki-laki pergi</segment> ke kegiatan sepulang <segment id='12' features='eror;ejaan;ejsp' state='active'>sekolah.</segment><segment id='17' features='eror;leksikal;kata;ktvar' state='active'>Dia</segment> sedang bermain bisbol.
Dia pergi ke kegiatan klub pada hari Sabtu dan <segment id='13' features='eror;ejaan;ejsp' state='active' parent='17'>Minggu.Dia</segment> pulang jam <segment id='14' features='eror;ejaan;ejsp' state='active' parent='17'>delapan.Dia</segment> pergi tidur jam 12.</segment>    </body>
