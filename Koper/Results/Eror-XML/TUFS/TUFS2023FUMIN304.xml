Kami bermaksud akan mengadakan <segment id='1' features='eror;ejaan;ejk' state='active' comment='kata &quot;pertunjukkan&quot; tidak perlu diawali dengan huruf kapital karena bukan nama diri.' correction='pertunjukkan Akapela'><segment id='16' features='eror;ejaan;ejhrf' state='active' parent='1'>Pertunjukkan</segment></segment> <segment id='17' features='eror;ejaan;ejk' state='active'>Akapela</segment> untuk <segment id='18' features='eror;gramatikal;frasa-nomina;nom0' state='active' correction='hasil'><segment id='2' features='eror;leksikal;kata;vrbs' state='active' correction='menampilkan' parent='18'>mempelajari</segment> latihan</segment> harian kami. <segment id='3' features='eror;lainnya;lain' state='active' comment='Angka tidak dapat ditulis pada awal kalimat.' correction='Sepuluh'>10</segment> <segment id='4' features='eror;leksikal;kata;ktas' state='active' comment='Band merupakan istilah bahasa inggris. Dalam bahasa Indonesia, padanannya adalah &quot;grup musik&quot;.' correction='grup musik'>band</segment> yang menang <segment id='5' features='eror;ejaan;ejk' state='active' comment='Tidak perlu menggunakan huruf kapital karena bukan nama diri dan tidak terletak di awal kalimat.' correction='audisi'>Audisi</segment> akan <segment id='19' features='eror;gramatikal;frasa-verba;vrbafx' state='active' correction='bernyanyi'>menyanyi</segment> dan juga semua anggota <segment id='6' features='eror;gramatikal;frasa-verba;vrbaux0' state='active' correction='akan'>LINES <segment id='20' features='eror;gramatikal;frasa-verba;vrbafx' state='active' correction='menyanyikan' parent='6'>menyanyi</segment></segment> 3 lagu bersama-sama. Kami sangat mengharapkan kehadiran Bapak/Ibu.

<segment id='8' features='eror;ejaan;ejk' state='active' comment='Tidak perlu menggunakan nomina &quot;waktu&quot;. Langsung pada rincian tanggal, hari, dan jam.'>・waktu :</segment> 
