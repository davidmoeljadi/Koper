Cerita tentang Kamarku

Di kamarku<segment id='1' features='eror;ejaan;ejsp' state='active'>,<segment id='2' features='eror;gramatikal;frasa-verba;urtfv' state='active'>meja</segment> yang hitam terdapat</segment><segment id='5' features='eror;ejaan;ejsp' state='active'>.Di</segment> atas meja itu<segment id='3' features='eror;ejaan;ejsp' state='active'>,<segment id='4' features='eror;ejaan;ejk' state='active' parent='3'><segment id='66' features='eror;leksikal;kata;ktinf' state='active' parent='4'>Saya</segment></segment></segment> meletakkan monitor untuk bermain game dan <segment id='6' features='eror;ejaan;ejhrf' state='active'>perangat</segment> game<segment id='7' features='eror;ejaan;ejsp' state='active'>.<segment id='67' features='eror;leksikal;kata;ktinf' state='active' parent='7'>Saya</segment></segment> sering bermain game <segment id='8' features='eror;ejaan;ejsp' state='active'>di  kamarku</segment>.
<segment id='68' features='eror;leksikal;kata;konjs' state='active'>Tetapi</segment><segment id='9' features='eror;ejaan;ejsp' state='active'>,karena</segment> ada <segment id='10' features='eror;leksikal;ungkapan;ukpa' state='active'>itu</segment> di atas meja<segment id='11' features='eror;ejaan;ejsp' state='active'>,<segment id='12' features='eror;leksikal;kata;noms' state='active' parent='11'>Spasi</segment></segment> <segment id='13' features='eror;leksikal;ungkapan;ukps' state='active'>yang mangadakan hal lain tidak terdapat</segment><segment id='14' features='eror;ejaan;ejsp' state='active'>.<segment id='69' features='eror;ejaan;ejtb' state='active'>Jadi</segment> <segment id='71' features='eror;leksikal;kata;ktinf' state='active' parent='69'>saya</segment></segment> belajar dengan berbaring<segment id='15' features='eror;ejaan;ejsp' state='active'>.Di</segment> sini<segment id='16' features='eror;ejaan;ejsp' state='active'>,<segment id='18' features='eror;gramatikal;frasa-verba;urtfv' state='active'><segment id='17' features='eror;ejaan;ejhrf' state='active' parent='18'>menera</segment></segment> kucing juga terdapat</segment><segment id='19' features='eror;ejaan;ejsp' state='active'>.<segment id='20' features='eror;ejaan;ejk' state='active' parent='19'><segment id='70' features='eror;leksikal;kata;ktinf' state='active' parent='20'>saya</segment></segment></segment> mempunyai satu kucing<segment id='21' features='eror;ejaan;ejsp' state='active'>.Kucing</segment> <segment id='72' features='eror;leksikal;kata;ktinf' state='active'>saya</segment> sering tidur atau bermain di <segment id='22' features='eror;ejaan;ejhrf' state='active'>menera</segment> itu<segment id='23' features='eror;ejaan;ejsp' state='active'>.Sebuah</segment> jendela terdapat di kamarku<segment id='24' features='eror;ejaan;ejsp' state='active'>,tetapi</segment> itu sangat <segment id='25' features='eror;ejaan;ejtb' state='active'>kecil jadi</segment> <segment id='73' features='eror;leksikal;kata;ktinf' state='active'>saya</segment> harus <segment id='26' features='eror;ejaan;ejhrf' state='active'>menyelakan</segment> lampu sepanjang hari<segment id='27' features='eror;ejaan;ejsp' state='active'>.<segment id='74' features='eror;leksikal;kata;ktinf' state='active' parent='27'>Saya</segment></segment> tidur dengan kasur dan bantal<segment id='28' features='eror;ejaan;ejsp' state='active'>.Bantalku</segment> sangat lembut<segment id='29' features='eror;ejaan;ejsp' state='active'>.<segment id='75' features='eror;leksikal;kata;ktinf' state='active' parent='29'>Saya</segment></segment> menyukai <segment id='76' features='eror;gramatikal;frasa-nomina;nyaitu' state='active'>itu</segment><segment id='30' features='eror;ejaan;ejsp' state='active'>.Kamarku</segment> memiliki satu pintu<segment id='33' features='eror;ejaan;ejsp' state='active'>.<segment id='35' features='eror;leksikal;kata;ktvar' state='active' parent='33'>Itu</segment></segment> berwarna cokelat<segment id='36' features='eror;ejaan;ejsp' state='active'>.Lantai</segment> di sini juga berwarna cokelat<segment id='37' features='eror;ejaan;ejsp' state='active'>.Lemari</segment> <segment id='31' features='eror;leksikal;kata;ktinf' state='active'>saya</segment> berwarna putih dan lebar<segment id='39' features='eror;ejaan;ejsp' state='active'>.Rak</segment> buku <segment id='32' features='eror;leksikal;kata;ktinf' state='active'>saya</segment> lebar dan hitam<segment id='38' features='eror;ejaan;ejsp' state='active'>.<segment id='34' features='eror;leksikal;kata;ktinf' state='active' parent='38'>Saya</segment></segment> suka <segment id='40' features='eror;ejaan;ejhrf' state='active'>menbaca</segment> buku manga.
<segment id='44' features='eror;leksikal;ungkapan;ukpa' state='active'>Kamarku sangat sempit <segment id='41' features='eror;leksikal;kata;konjs' state='active' parent='44'>karena</segment> pembersihan <segment id='42' features='eror;ejaan;ejhrf' state='active' parent='44'>kamaerku</segment> selesai <segment id='43' features='eror;ejaan;ejhrf' state='active' parent='44'>segara</segment></segment><segment id='45' features='eror;ejaan;ejsp' state='active'>.<segment id='46' features='eror;ejaan;ejhrf' state='active' parent='45'>Tatapi</segment></segment> karena <segment id='77' features='eror;leksikal;kata;ktinf' state='active'>saya</segment> malas<segment id='47' features='eror;ejaan;ejsp' state='active'>,<segment id='78' features='eror;leksikal;kata;ktinf' state='active' parent='47'>saya</segment></segment> tidak membersihkan kamarku.
<segment id='48' features='eror;leksikal;ungkapan;ukpa' state='active'>Tanpa AC<segment id='49' features='eror;ejaan;ejsp' state='active' parent='48'>,sangat</segment> panas di dalam kamarku waktu musim panas dan sangat dingin waktu musim dingin<segment id='50' features='eror;ejaan;ejsp' state='active' parent='48'>,<segment id='52' features='eror;leksikal;kata;konjs' state='active' parent='50'>karena</segment></segment> <segment id='79' features='eror;leksikal;kata;ktinf' state='active' parent='48'>saya</segment> sering <segment id='51' features='eror;gramatikal;frasa-verba;vrbafx' state='active' parent='48'>nyalakan</segment> AC di kamarku</segment><segment id='53' features='eror;ejaan;ejsp' state='active'>.Rumahku</segment> terletak di atas gunung<segment id='54' features='eror;ejaan;ejsp' state='active'>,jadi</segment> ketika <segment id='80' features='eror;leksikal;kata;ktinf' state='active'>saya</segment> pergi ke TUFS<segment id='55' features='eror;ejaan;ejsp' state='active'>,<segment id='81' features='eror;leksikal;kata;ktinf' state='active' parent='55'>saya</segment></segment> bisa berlari cepat ke stasiun yang paling dekat dari rumahku<segment id='82' features='eror;ejaan;ejsp' state='active'>.<segment id='83' features='eror;leksikal;kata;konjs' state='active' parent='82'>Tetapi</segment></segment><segment id='56' features='eror;ejaan;ejsp' state='active'>,waktu</segment> <segment id='84' features='eror;leksikal;kata;ktinf' state='active'>saya</segment> pulang ke rumahku dari <segment id='57' features='eror;ejaan;ejhrf' state='active'>sutasiun</segment> yang paling dekat dari <segment id='58' features='eror;ejaan;ejtb' state='active'>rumahku <segment id='85' features='eror;leksikal;kata;ktinf' state='active' parent='58'>saya</segment></segment> merasa sedih karena <segment id='59' features='eror;leksikal;ungkapan;ukpa' state='active'>sangat lelah ke rumahku</segment><segment id='60' features='eror;ejaan;ejsp' state='active'>.<segment id='61' features='eror;leksikal;kata;noms' state='active' parent='60'>Kamar</segment>ku</segment> terdapat di Yokohama<segment id='86' features='eror;ejaan;ejsp' state='active'>.<segment id='62' features='eror;gramatikal;frasa-nomina;nomafx' state='active' parent='86'>Hidupan</segment></segment> di Yokohama <segment id='87' features='eror;gramatikal;frasa-adjektiva;urtfaj' state='active'><segment id='65' features='eror;leksikal;kata;adjs' state='active' parent='87'>buruk</segment> kadang-kadang</segment> karena ada banyak <segment id='63' features='eror;ejaan;ejtb' state='active'>orang tetapi</segment> nyaman <segment id='64' features='eror;leksikal;kata;preps' state='active'>tentang</segment> belanja.    </body>
