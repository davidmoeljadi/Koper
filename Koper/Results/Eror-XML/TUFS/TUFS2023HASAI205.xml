    <body>
Hobi yang paling saya <segment id='28' features='eror;gramatikal;frasa-verba;vrbafx' state='active' correction='sukai'>suka</segment> adalah menonton <segment id='1' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi'>bisbol.Saya</segment> suka Lions. <segment id='2' features='eror;leksikal;kata;noms' state='active' comment='Nomina lebih tepat digunakan daripada determina yang difungsikan sebagai pronomina.' correction='Lions'>Itu</segment> tim bisbol di <segment id='4' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi'>Saitama.<segment id='5' features='eror;leksikal;kata;konjs' state='active' comment='Sebaiknya dihilangkan saja karena kalimatnya tunggal dan tidak ada yang perlu dipertentangkan.' parent='4'>tetapi</segment></segment> saya tidak pernah bermain <segment id='7' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi'>bisbol.<segment id='8' features='eror;leksikal;kata;konjs' state='active' comment='Konjungsi untuk menyatakan waktu yang paling tepat adalah &quot;ketika&quot;' correction='Ketika' parent='7'>Waktu</segment></segment> <segment id='10' features='eror;gramatikal;frasa-verba;vrbaux0' state='active' correction='masih menjadi'>saya <segment id='13' features='eror;leksikal;kata;noms' state='active' comment='penyebutan mahasiswa khusus untuk pelajar tingkat sarjana ke atas. Untuk pelajar SMA ke bawah, cukup memakai &quot;siswa&quot;' correction='siswa' parent='10'>mahasiswa</segment></segment> di SMA, saya <segment id='11' features='eror;leksikal;kata;vrbs' state='active' correction='ikut'><segment id='12' features='eror;gramatikal;frasa-verba;vrbpas' state='active' correction='mengikuti' parent='11'>dimiliki</segment></segment> kegiatan <segment id='14' features='eror;leksikal;kata;noms' state='active' comment='penyebutan mahasiswa khusus untuk pelajar tingkat sarjana ke atas. Untuk pelajar SMA ke bawah, cukup memakai &quot;siswa&quot;' correction='siswa'>mahasiswa</segment> <segment id='15' features='eror;leksikal;kata;ktas' state='active' correction='bola tangan'><segment id='16' features='eror;ejaan;ejk' state='active' correction='bola tangan' parent='15'>Handbol</segment></segment>. Di kegiatan <segment id='3' features='eror;leksikal;kata;noms' state='active'>mahasiswa</segment> itu, hampir <segment id='17' features='eror;gramatikal;frasa-nomina;nomj' state='active' comment='Jika telah memakai &quot;semua&quot;, tidak perlu lagi menggunakan kata ulang dan sebaliknya' correction='&quot;semua teman&quot; atau &quot;teman-teman&quot;'>semua <segment id='6' features='eror;gramatikal;frasa-nomina;pron0' state='active' correction='saya' parent='17'>teman-teman</segment></segment> suka menonton <segment id='18' features='eror;ejaan;ejtb' state='active' comment='Tidak perlu memakai tanda koma'>bisbol, <segment id='9' features='eror;leksikal;kata;konjs' state='active' correction='jadi' parent='18'>karena</segment></segment> saya menjadi <segment id='33' features='eror;ejaan;ejhrf' state='active' correction='penggemar'>penngemar</segment> <segment id='19' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi'>Lions.Pemain</segment> bisbol yang <segment id='34' features='eror;gramatikal;frasa-verba;urtfv' state='active' correction='paling saya suka'>saya paling <segment id='35' features='eror;gramatikal;frasa-verba;vrbafx' state='active' parent='34'>suka</segment></segment> adalah Nakamura <segment id='20' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi'>Takeya.Dia</segment> memukul banyak home run. Dia berbadan <segment id='21' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi'>gemuk,tetapi</segment> dia bisa berlari cepat. <segment id='23' features='eror;gramatikal;kalimat;kalpan' state='active' correction='Saya menonton bisbol di TV setiap hari. Selain itu, saya pergi ke stadium dan mendukung Lions'>Saya menonton bisbol di TV setiap hari, selain <segment id='24' features='eror;ejaan;ejtb' state='active' comment='Kekurangan koma' parent='23'>itu <segment id='25' features='eror;gramatikal;frasa-adverbia;adv0' state='active' correction='juga' parent='23'>saya</segment> pergi</segment> ke <segment id='22' features='eror;ejaan;ejhrf' state='active' parent='23'>stadium</segment> dan mendukung Lions.</segment> Sekarang, Lions <segment id='27' features='eror;gramatikal;frasa-preposisi;prep0' state='active' correction='di tempat'><segment id='36' features='eror;gramatikal;frasa-nomina;nom0' state='active' parent='27'><segment id='26' features='eror;leksikal;kata;vrbs' state='active' correction='berada' parent='36'>terletak</segment> pertama</segment></segment> di dalam <segment id='29' features='eror;ejaan;ejhrf' state='active' correction='La Liga'><segment id='30' features='eror;ejaan;ejtb' state='active' correction='La Liga' parent='29'>Pa-Liga</segment></segment>, jadi saya merasa sangat senang.    </body>
