    <body>
Kafe <segment id='1' features='eror;ejaan;ejk' state='active' correction='Kafe Favorit Saya: Ranzu Kafe'>favorit saya<segment id='13' features='eror;ejaan;ejtb' state='active' comment='Tanda baca tilde [~] tidak digunakan pada penulisan judul. Sebagai penjelas nama kafe, dapat menggunakan tanda titik dua [:].' correction='Kafe Favorit Saya: Ranzu Kafe' parent='1'>～ranzu kafe~</segment></segment>

Nama kafe favorit saya <segment id='3' features='eror;ejaan;ejhrf' state='active' correction='adalah'>adahah</segment> <segment id='4' features='eror;ejaan;ejtb' state='active' comment='Tanpa tanda petik.'>“<segment id='5' features='eror;ejaan;ejk' state='active' comment='Penamaan kafe menggunakan kapital karena termasuk nama diri.' correction='Ranzu Kafe' parent='4'>ranzu kafe</segment>”</segment>.
Kafe ini ada di dekat <segment id='14' features='eror;ejaan;ejk' state='active' comment='Kapitalisasi huruf &quot;s&quot; karena dalam konteks kalimat, &quot;Stasiun Beppu&quot; adalah nama diri.' correction='Stasiun'>stasiun</segment> Beppu, kira-kira 5 menit dari <segment id='7' features='eror;ejaan;ejk' state='active'>stasiun</segment> Beppu.
Saya suka kafe <segment id='6' features='eror;ejaan;ejtb' state='active' comment='Di antara kata &quot;ini&quot; dan &quot;karena&quot; tidak dibersamai tanda koma [.].' correction='Saya suka kafe ini karena....'>ini, karena</segment> menu <segment id='8' features='eror;gramatikal;frasa-nomina;nyaitu' state='active'>ini</segment> sangat menarik dan unik.
Saya makan <segment id='15' features='eror;ejaan;ejk' state='active' correction='napolitan'>Napolitan</segment> dengan <segment id='2' features='eror;leksikal;kata;ktas' state='active' comment='Penggunaan bahasa asing di tengah kalimat (bukan padanan).' correction='telur.'>egg</segment>. <segment id='9' features='eror;ejaan;ejhrf' state='active'>Bahan-bahanya</segment> berasal dari Oita. Rasanya enak sekali <segment id='16' features='eror;gramatikal;frasa-nomina;nom0' state='active' comment='Perlu penambahan nomina &quot;teksturya&quot; agar kalimat setara.' correction='dan teksturnya lembut.'>dan lembut</segment>.
Kafe ini <segment id='20' features='eror;gramatikal;frasa-verba;urtfv' state='active'>ada juga</segment> <segment id='10' features='eror;gramatikal;frasa-nomina;urtfn' state='active'>banyak parfait menu</segment>. Parfait <segment id='21' features='eror;leksikal;kata;preps' state='active' comment='Preposisi &quot;pada&quot; digunakan untuk sesuatu yang abstrak, sementara dalam konteks kalimat, dibutuhkan preposisi yang ditujukan untuk objek pasti (menu), maka diperlukan preposisi &quot;di&quot;.' correction='di'>pada</segment> menu <segment id='19' features='eror;ejaan;ejhrf' state='active' correction='terlihat'>terihat</segment> cukup <segment id='17' features='eror;ejaan;ejtb' state='active' comment='Perlu tanda koma sebelum &quot;tetapi&quot;.' correction='... besar, tetapi'>besar <segment id='18' features='eror;leksikal;kata;ktinf' state='active' correction='tetapi' parent='17'>tapi</segment></segment> tidak terlalu mahal untuk saya. Saya mau <segment id='22' features='eror;gramatikal;frasa-verba;vrbafx' state='active'>coba</segment> <segment id='11' features='eror;gramatikal;frasa-nomina;urtfn' state='active' comment='Penulisan &quot;parfait puding&quot; mentranslasi bahasa asing ke dalam bahasa Indonesia sehingga urutan frasa terbalik.' correction='Lain kali, saya mau coba puding parfait dengan teman saya.'>parfait puding</segment> lain kali dengan <segment id='12' features='eror;ejaan;ejhrf' state='active' correction='teman'>taman</segment> saya.
<segment id='26' features='eror;gramatikal;kalimat;kalpen' state='active'>Kafe ini ramah sekali untuk anak dan ibu. Saya <segment id='23' features='eror;gramatikal;frasa-verba;vrbafx' state='active' correction='menyukainya' parent='26'>suka</segment> <segment id='24' features='eror;gramatikal;frasa-preposisi;prepx' state='active' parent='26'>tentang</segment> <segment id='25' features='eror;gramatikal;frasa-nomina;nyaitu' state='active' parent='26'>itu</segment>.</segment>    </body>
