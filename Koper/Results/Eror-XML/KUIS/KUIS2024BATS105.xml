    <body>
Selamat <segment id='1' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='siang, semuanya. Apa'><segment id='48' features='eror;ejaan;ejtb' state='active' comment='Kekurangan tanda baca koma [,]' correction='siang, semuanya' parent='1'>siangsemuanya</segment>.Apa</segment> <segment id='2' features='eror;ejaan;ejsp' state='active' correction='kabar? Kali'>kabar?Kali</segment> ini saya akan bercerita tentang <segment id='3' features='eror;ejaan;ejtb' state='active' comment='Penggunaan tanda petik tidak perlu' correction='cara pergi dari rumah saya ke stasiun terdekat'>&quot;cara pergi dari rumah saya ke stasiun <segment id='4' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='terdekat. Stasiun'>terdekat&quot;</segment>.Stasiun</segment> yang terdekat dari rumah saya adalah Stasiun <segment id='6' features='eror;ejaan;ejsp' state='active' correction='Shinkemigawa. Stasiun'>Shinkemigawa.Stasiun</segment> itu <segment id='7' features='eror;ejaan;ejhrf' state='active' correction='tidak'>ttidak</segment> besar dan ada <segment id='8' features='eror;gramatikal;frasa-verba;vrb0' state='active' comment='Kekurangan verba &quot;memiliki&quot;' correction='hanya memiliki satu jalur'>hanya<segment id='9' features='eror;leksikal;kata;dets' state='active' correction='satu jalur' parent='8'>1 jalur</segment></segment> kereta <segment id='10' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='listrik, yaitu'>listrik,yaitu</segment> Jalur JR <segment id='12' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='Sobu. Stasiun'><segment id='11' features='eror;ejaan;ejhrf' state='active' correction='Sobu' parent='12'>Soubu</segment>.<segment id='5' features='eror;ejaan;ejhrf' state='active' correction='Stasiun' parent='12'>Stasaiun</segment></segment> itu jauh dari rumah <segment id='13' features='eror;ejaan;ejsp' state='active' correction='saya. Dari'>saya.Dari</segment> rumah saya ke stasiun itu memakan waktu kira-kira 20 menit dengan bus atau sepeda.

Rumah saya ada di lantai 4 dan <segment id='14' features='eror;ejaan;ejhrf' state='active' correction='apartemen'>apartement</segment> itu tidak ada <segment id='15' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='lift, jadi'>lift,jadi</segment> sesudah keluar dari <segment id='16' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='rumah, saya'>rumah,saya</segment> turun tangga sampai di <segment id='17' features='eror;ejaan;ejsp' state='active' correction='lantai 1. Setelah'>lantai 1.Setelah</segment> meninggalkan <segment id='18' features='eror;ejaan;ejtb' state='active' comment='Penempatan tanda baca koma kurang tepat' correction='rumah, saya belok'>rumah saya,belok</segment> ke kiri dua kali dan berjalan lurus <segment id='49' features='eror;gramatikal;frasa-preposisi;prep0' state='active' comment='Kekurangan preposisi &quot;ke&quot;' correction='sampai ke tempat'>sampai tempat</segment> naik <segment id='19' features='eror;ejaan;ejsp' state='active' correction='bus. Saya'>bus.Saya</segment> selalu naik bus <segment id='20' features='eror;leksikal;kata;prons' state='active' comment='kata penunjuk untuk menyatakan tempat yang agak jauh dari pembicara (KBBI)' correction='di sana'>di <segment id='21' features='eror;ejaan;ejsp' state='active' correction='sana. Jarak'>sini</segment>.<segment id='50' features='eror;gramatikal;frasa-nomina;nom0' state='active' comment='Kekurangan nomina &quot;jarak&quot;' correction='Jarak dari' parent='21'>Dari</segment></segment> rumah saya ke <segment id='22' features='eror;ejaan;ejk' state='active' correction='Stasiun Shinkemigawa'>stasiun Shinkemigawa</segment> adalah 4 <segment id='23' features='eror;ejaan;ejsp' state='active' correction='kilometer, jadi'>kilometer,jadi</segment> saya harus naik bus ketika cuaca <segment id='24' features='eror;gramatikal;konjungsi;konj0' state='active' comment='Kekurangan konjungsi &quot;Selanjutnya,&quot;. Selain itu, menghindari penulisan angka pada awal kalimat' correction='buruk. Selanjutnya, 300 meter'><segment id='51' features='eror;ejaan;ejsp' state='active' parent='24'>buruk.<segment id='25' features='eror;gramatikal;kalimat;kalpen' state='active' correction='Selanjutnya, 300 meter dari sini ada minimarket, dan 400 meter dari sini ada Welcia.'>300</segment></segment> meter dari sini,ada minimarket.400 meter dari sini ada <segment id='26' features='eror;ejaan;ejsp' state='active' correction='Welcia. Sesudah'>Welcia.</segment>Sesudah</segment> belok kanan ke <segment id='27' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='sana, ada'>sana,ada</segment> <segment id='29' features='eror;ejaan;ejsp' state='active' correction='Maruetsu. Maruetsu'><segment id='28' features='eror;ejaan;ejk' state='active' comment='Penggunaan huruf kapital karena merujuk pada nama diri' correction='Maruetsu' parent='29'>maruetsu</segment>.<segment id='30' features='eror;gramatikal;frasa-verba;vrb0' state='active' comment='Kekurangan verba &quot;adalah&quot;' correction='Maruetsu adalah nama'>Maruetsu</segment> <segment id='31' features='eror;gramatikal;frasa-nomina;detx' state='active' comment='Kata &quot;itu&quot; dapat dihilangkan. Sebagai gantinya, gunakan verba &quot;adalah&quot;' parent='30'>itu</segment> nama</segment> <segment id='33' features='eror;ejaan;ejsp' state='active' correction='supermarket. Sedikit'><segment id='32' features='eror;ejaan;ejhrf' state='active' correction='supermarket' parent='33'>sepermarket</segment>.Sedikit</segment> lebih jauh di <segment id='34' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='sana, ada Famima, LIFE, dan Gusto. Sedikit'>sana,ada Famima,LIFE,dan <segment id='36' features='eror;ejaan;ejk' state='active' comment='Penggunaan huruf kapital karena merujuk pada nama diri' correction='Gusto' parent='34'>gusto</segment>.Sedikit</segment> jauh dari <segment id='37' features='eror;ejaan;ejsp' state='active' correction='Gusto, belok'><segment id='35' features='eror;ejaan;ejk' state='active' comment='Penggunaan huruf kapital karena merujuk pada nama diri' correction='Gusto' parent='37'>gusto</segment>,belok</segment> ke <segment id='38' features='eror;ejaan;ejsp' state='active' correction='kiri, dan'>kiri,dan</segment> berjalan lurus kira-kira <segment id='39' features='eror;ejaan;ejtb' state='active' correction='1,3'>1.3</segment> <segment id='40' features='eror;ejaan;ejsp' state='active' correction='kilometer, ada'>kilometer,ada</segment> <segment id='41' features='eror;ejaan;ejhrf' state='active' correction='Stasiun'>Staisun</segment> <segment id='43' features='eror;ejaan;ejsp' state='active' correction='Shinkemigawa. Di'>Shinkemigawa.<segment id='42' features='eror;ejaan;ejk' state='active' correction='Di' parent='43'>DI</segment></segment> Stasiun <segment id='44' features='eror;ejaan;ejsp' state='active' correction='Shinkemigawa, kereta'>Shinkemigawa,kereta</segment> datang setiap 15 menit <segment id='45' features='eror;ejaan;ejsp' state='active' correction='sekali. Saya'>sekali.<segment id='47' features='eror;gramatikal;kalimat;kalpan' state='active' correction='Saya tidak naik kereta kecuali jika saya pergi jauh. Oleh karena itu, ketika saya pergi ke kampus, saya selalu naik sepeda.'>Saya</segment> tidak naik kereta <segment id='46' features='eror;gramatikal;konjungsi;konj0' state='active' comment='Kekurangan konjungsi &quot;jika&quot;' correction='kecuali jika saya' parent='47'>kecuali saya</segment> pergi jauh,jadi ketika saya pergi ke kampus saya selalu naik sepeda.</segment>    </body>
