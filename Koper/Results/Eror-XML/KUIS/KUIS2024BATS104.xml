<segment id='1' features='eror;ejaan;ejk' state='active' comment='Jika baris awal merupakan judul, maka gunakan huruf kapital pada setiap katanya' correction='Sekitar Rumah Saya'>sekitar rumah saya</segment>

Saya tinggal sendiri di apartemen di <segment id='2' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='Satsukigaoka, Kecamatan'>Satsukigaoka,Kecamatan</segment> <segment id='3' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='Hanamigawa, Kota'>Hanamigawa,Kota</segment> <segment id='4' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='Chiba. Saya'>Chiba.Saya</segment> tinggal di sana sejak <segment id='5' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='tahun 2005. Saya'>tahun2005.Saya</segment> suka tinggal di sana dan tidak mau pindah karena banyak teman tinggal di <segment id='6' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='sana. Mereka'>sana.Mereka</segment> dan saya berteman baik.
Sekitar apartemen saya <segment id='7' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='sepi. Tidak'>sepi.Tidak</segment> ada bangunan <segment id='8' features='eror;gramatikal;frasa-nomina;yg0' state='active' comment='Kekurangan kata &quot;yang&quot;' correction='besar yang tinggi'>besar tinggi</segment> <segment id='9' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='sekali. Di'>sekali.Di</segment> depan rumah saya ada <segment id='10' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='taman. Ketika'>taman.Ketika</segment> saya <segment id='11' features='eror;ejaan;ejtb' state='active' comment='Kekurangan tanda baca koma [,]' correction='kecil, saya'>kecil saya</segment> banyak bermain dengan teman saya di <segment id='12' features='eror;ejaan;ejsp' state='active' correction='sana. Di'>sana.Di</segment> dekat rumah <segment id='13' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='saya, ada'>saya,ada</segment> <segment id='14' features='eror;leksikal;kata;dets' state='active' correction='empat minimarket'>4 <segment id='15' features='eror;ejaan;ejsp' state='active' correction='minimarket, jadi'>minimarket</segment>,jadi</segment> saya bisa pergi ke minimarket waktu saya ada di sekitar rumah <segment id='16' features='eror;ejaan;ejsp' state='active' correction='saya. Ketika'>saya.Ketika</segment> saya mau membeli <segment id='18' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='famichiki, saya'><segment id='17' features='eror;ejaan;ejhrf' state='active' comment='Famichiki adalah ayam goreng tanpa tulang yang populer dan dijual di toko-toko swalayan Family Mart di Jepang.' correction='famichiki' parent='18'>famiciki</segment>,saya</segment> selalu pergi ke Famima dengan <segment id='19' features='eror;ejaan;ejsp' state='active' correction='kereta. Bukan'>kereta.Bukan</segment> hanya <segment id='20' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='minimarket, banyak juga Welcia'>minimarket,<segment id='21' features='eror;gramatikal;frasa-adverbia;adv0' state='active' comment='Kekurangan adverbia &quot;juga&quot;' correction='banyak juga Welcia' parent='20'>banyak<segment id='23' features='eror;ejaan;ejk' state='active' comment='Penggunaan huruf kapital karena merujuk pada nama diri' correction='Welcia' parent='21'>welcia</segment></segment></segment> <segment id='22' features='eror;gramatikal;frasa-verba;vrbx' state='active' comment='Verba &quot;ada&quot; dapat dihilangkan'>ada</segment> di sekitar rumah <segment id='24' features='eror;ejaan;ejsp' state='active' correction='saya. Banyak'>saya.Banyak</segment> orang tua tinggal di sekitar rumah <segment id='25' features='eror;ejaan;ejsp' state='active' correction='saya. Mereka'>saya.<segment id='26' features='eror;gramatikal;kalimat;kalpan' state='active' correction='Mereka selalu berkata, &quot;Okaeri.&quot; Namun, saya tidak tahu bagaimana harus menjawabnya, tetapi mereka sangat baik.'>Mereka</segment> selalu berkata &quot;okaeri&quot;tapi saya tidak <segment id='27' features='eror;ejaan;ejhrf' state='active' correction='tahu' parent='26'>tahuh</segment> bagaimana saya harus memjawab,tetapi mereka sangat baik.</segment>
Di sebelah kanan rumah saya ada rumah teman <segment id='28' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='saya. Di'>saya.Di</segment> sebelah kiri juga ada teman rumah teman <segment id='29' features='eror;ejaan;ejsp' state='active' correction='saya. Kira-kira'>saya.Kira-kira</segment> 100 meter dari rumah saya ada <segment id='31' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='supermarket. Saya'><segment id='30' features='eror;ejaan;ejhrf' state='active' correction='supermarket' parent='31'>sepermarket</segment>.Saya</segment> selalu membeli <segment id='32' features='eror;leksikal;kata;noms' state='active' comment='Penggunaan &quot;masakan&quot; sebenarnya berterima, tetapi lebih umum &quot;makanan&quot;' correction='makanan'>masakan</segment> di <segment id='33' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='sana, karena'>sana,<segment id='34' features='eror;gramatikal;frasa-nomina;nom0' state='active' comment='Kekurangan nomina &quot;harganya&quot;' correction='karena harganya sangat'>karena</segment> sangat</segment> <segment id='35' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='murah. Di'>murah.Di</segment> sekitar <segment id='37' features='eror;ejaan;ejsp' state='active' correction='supermarket, ada'><segment id='36' features='eror;ejaan;ejhrf' state='active' correction='supermarket' parent='37'>sepermarket</segment>,ada</segment> banyak toko kecil.
Sekitar rumah saya sangat <segment id='38' features='eror;ejaan;ejsp' state='active' comment='Kekurangan spasi' correction='menyenangkan, tetapi tidak'>menyenangkan,<segment id='39' features='eror;leksikal;kata;ktinf' state='active' correction='tetapi' parent='38'>tapi</segment>tidak</segment> <segment id='40' features='eror;ejaan;ejsp' state='active' correction='praktis. Untuk'>praktis.<segment id='41' features='eror;gramatikal;kalimat;kalbel' state='active' correction='Untuk pergi ke stasiun, saya harus naik bus selama 20 menit.'>Untuk</segment> pergi ke stasiun,saya harus naik <segment id='42' features='eror;gramatikal;frasa-nomina;nom0' state='active' comment='Kekurangan nomina &quot;selama&quot;' correction='bus selama 20 menit' parent='41'>bus 20 menit</segment>,untuk pergi ke stasiun</segment>    </body>
