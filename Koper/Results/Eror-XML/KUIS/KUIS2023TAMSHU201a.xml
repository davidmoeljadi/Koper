    <body>
<segment id='1' features='eror;ejaan;ejtb' state='active' comment='Diperlukan tanda koma [,] setelah kata &quot;Hai&quot;.' correction='Hai, Tuti.'>Hai <segment id='2' features='eror;ejaan;ejtb' state='active' comment='Diperlukan tanda titik [.] di akhir kalimat, bukan tanda koma [,].' correction='Tuti.'>Tuti</segment>,</segment>

<segment id='24' features='eror;leksikal;kata;ktinf' state='active'><segment id='21' features='eror;gramatikal;kalimat;kalpen' state='active' correction='Saya mau menikah dengan Anda karena Anda baik dan cakap.' parent='24'>Saya <segment id='22' features='eror;gramatikal;frasa-verba;urtfv' state='active' correction='mau sekali menikah' parent='21'>mau menikah dengan Anda <segment id='23' features='eror;ejaan;ejsp' state='active' parent='21'>sekali</segment> .</segment>
Karena Anda baik, cakap,</segment> <segment id='3' features='eror;leksikal;ungkapan;ukpa' state='active' comment='Jika kalimat bermaka demikian, maka semestinya berdiri sendiri karena tidak setara dengan kalimat sebelumnya.' correction='Saya mencintai Anda.' parent='24'>dan dicinta dari saya .</segment>
Mungkin saya <segment id='5' features='eror;ejaan;ejtb' state='active' comment='Diperlukan tanda koma [,] sebelum kata &quot;tetapi&quot;.' correction='...kejam, tetapi ibu Anda...' parent='24'>kejam <segment id='4' features='eror;leksikal;kata;ktinf' state='active' correction='tetapi' parent='5'>tapi</segment></segment> ibu Anda tidak benar untuk <segment id='7' features='eror;gramatikal;frasa-nomina;pron0' state='active' correction='minta kamu menikah' parent='24'>minta menikah</segment> dengan anak temannya.
<segment id='9' features='eror' state='active' correction='Pertama, kamu...' parent='24'>Pertama Anda</segment> <segment id='8' features='eror;ejaan;ejhrf' state='active' correction='harus' parent='24'>halus</segment> mengatakan <segment id='10' features='eror;leksikal;kata;preps' state='active' correction='kepada' parent='24'>ke</segment> ibu anda bahwa <segment id='13' features='eror;ejaan;ejsp' state='active' correction='Anda tidak' parent='24'>anda  <segment id='14' features='eror;gramatikal;frasa-verba;vrbaux0' state='active' comment='Kalimat memerlukan kata &quot;akan&quot; untuk memperjelas konteks kemungkinan &quot;menikah&quot; di masa depan.' correction='tidak akan menikah' parent='24'>tidak</segment> menikah</segment> dengan dia. 
Anda tidak tahu tentang dia. Jadi Anda tidak bisa <segment id='15' features='eror;leksikal;kata;vrbs' state='active' comment='Kesalahan pemilihan verba karena konteks yang sedang dibicarakan oleh penulis adalah perkara pernikahan sehingga kata &quot;berjalan&quot; dapat diganti dengan &quot;menikah&quot;. Keterangan untuk kesalahan pemilihan verba (verbs) ditujukan untuk yang kata dasarnya selaras, sementara pada kasus ini, verbanya lain.' correction='menikah' parent='24'>berjalan</segment> dengan dia.
Kemudian, Anda <segment id='16' features='eror;ejaan;ejhrf' state='active' correction='harus' parent='24'>halus</segment> menikah dengan saya karena saya menyenangkan dan cocok dengan <segment id='17' features='eror;leksikal;kata;prons' state='active' correction='kamu' parent='24'>kami</segment>. 
<segment id='19' features='eror;gramatikal;konjungsi;konjx' state='active' comment='Kata &quot;yaitu&quot; dapat dihapus karena tidak selaras dengan kalimat sebelumnya. Kalimat ini dapat langsung didahului kata &quot;Anda&quot;.' correction='Anda tidak perlu....' parent='24'>Yaitu</segment> Anda tidak <segment id='18' features='eror;leksikal;ungkapan;ukpa' state='active' comment='Kata yang mungkin dimaksudkan oleh penulis adalah &quot;perlu&quot;.' correction='perlu' parent='24'>puluh</segment> mendengarkan ibumu.</segment>    </body>
