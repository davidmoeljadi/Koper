    <body>
<segment id='1' features='eror;ejaan;ejtb' state='active' comment='Diperlukan tanda koma [,] setelah kata &quot;Hai&quot;.' correction='Hai, Tuti.'>Hai <segment id='19' features='eror;ejaan;ejtb' state='active' comment='Diperlukan tanda titik [.] di akhir kalimat.' correction='Tuti.' parent='1'>Tuti</segment></segment>

Apa kabar? Aku baik-baik saja <segment id='3' features='eror;ejaan;ejtb' state='active' comment='Diperlukan tanda titik [.] untuk mengakhiri kalimat.' correction='Aku baik-baik saja di sini.'><segment id='2' features='eror;ejaan;ejsp' state='active' comment='Diperlukan spasi dalam menulis kata depan [di].' correction='di sini' parent='3'>disini</segment></segment>
<segment id='9' features='eror;gramatikal;kalimat;kalpan' state='active' correction='Aku sangat merindukanmu. Rasanya seperti ratusan tahun berlalu, walaupun hanya beberapa hari kita tidak bertemu.'><segment id='8' features='eror;ejaan;ejk' state='active' comment='Awal kalimat menggunakan huruf kapital.' correction='Aku' parent='9'>aku</segment> juga sangat merindukanmu walaupun sudah beberapa hari kita tidak bertemu itu sudah seperti ratusan tahun berlalu!</segment>
<segment id='4' features='eror;gramatikal;kalimat;kalpan' state='active' comment='Kalimat tidak memiliki tanda baca dan pemenggalan kalimat tidak pas (lihat kata &quot;untuk&quot; dan &quot;melamarmu&quot;). Kalimat dapat dipecah menjadi tiga' correction='Tunggu aku di sana. Aku akan datang untuk melamarmu. Segera beritahukan ibumu bahwa aku akan datang dan bertanggung jawab dengan seluruh hidupku untuk membuatmu bahagia, juga hidup orang tuamu.'>Tunggu aku <segment id='5' features='eror;ejaan;ejsp' state='active' comment='Preposisi [di-] ditulis dengan spasi.' correction='di sana' parent='4'>disana</segment> aku akan datang untuk 
<segment id='6' features='eror;ejaan;ejsp' state='active' comment='Enklitik [-mu] ditulis tanpa spasi.' correction='melamarmu' parent='4'><segment id='21' features='eror;ejaan;ejk' state='active' parent='6'>Melamar</segment> mu</segment> segera beritahukan kepada ibumu bahwa aku akan datang dan aku akan bertanggung jawab dengan seluruh hidupku untuk membuatmu bahagia serta membuat orang tuamu juga <segment id='22' features='eror;ejaan;ejtb' state='active' parent='4'>bahagia</segment></segment> 
<segment id='7' features='eror;gramatikal;kalimat;kalobj' state='active' comment='Objek mungkin &quot;perjodohan&quot; apabila melihat konteks lanjutan dari fail KUIS2023TAMSHUI201.' correction='Kamu harus menolak perjodohan itu karena aku mencintaimu, Tuti.'>Kamu harus menolak karena aku <segment id='10' features='eror;ejaan;ejtb' state='active' correction='mencintaimu, Tuti' parent='7'>mencintaimu <segment id='11' features='eror;ejaan;ejtb' state='active' comment='Diperlukan tanda titik [.]' correction='Tuti.' parent='10'>Tuti</segment></segment></segment>
<segment id='12' features='eror;leksikal;kata;konjs' state='active' comment='Kata &quot;dan&quot; tidak digunakan di awal kalimat. Perlu penghapusan kata sehingga kata &quot;aku&quot; menjadi awalan untuk kalimat.' correction='Selain itu, aku akan berjuang untuk menikahimu, Tuti.'>Dan</segment> aku akan <segment id='13' features='eror;gramatikal;frasa-preposisi;prep0' state='active' correction='berjuang untuk menikahimu'>berjuang <segment id='14' features='eror;ejaan;ejtb' state='active' comment='Diperlukan tanda koma [,].' correction='menikahimu, Tuti.'>menikahimu</segment> <segment id='15' features='eror;ejaan;ejtb' state='active' comment='Diperlukan tanda titik [.] untuk mengakhiri kalimat.' correction='Tuti.' parent='14'>Tuti</segment></segment>
Salam <segment id='16' features='eror;ejaan;ejk' state='active' correction='hangat'>Hangat</segment> dariku buat seluruh <segment id='20' features='eror;ejaan;ejtb' state='active' comment='Diperlukan tanda titik [.] di akhir kalimat.' correction='keluargamu.'>keluargamu</segment>

Salam <segment id='17' features='eror;ejaan;ejtb' state='active' comment='Diperlukan tanda koma [,].' correction='Salam sayang, Tuti.'>sayang <segment id='18' features='eror;ejaan;ejtb' state='active' comment='Diperlukan tanda titik [.] untuk mengakhiri kalimat.' correction='Tuti.' parent='17'>Tuti</segment></segment>    </body>
