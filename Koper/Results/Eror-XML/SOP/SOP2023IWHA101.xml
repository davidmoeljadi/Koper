<segment id='8' features='eror;leksikal;kata;ktvar' state='active'>Saya pergi ke Ehime dan <segment id='1' features='eror;ejaan;ejsp' state='active' correction='Kyoto. Saya' parent='8'>Kyoto.<segment id='15' features='eror;gramatikal;kalimat;kalpen' state='active' correction='Saya pergi ke Ehime untuk berjumpa dengan kakek dan nenek serta makan mikan dan ikan, sedangkan ke Kyoto untuk berjumpa dengan teman saya yang tinggal di Kyoto.' parent='8'>Saya</segment> pergi <segment id='2' features='eror;ejaan;ejsp' state='active' correction='ke Ehime' parent='15'>keEhime</segment> untuk <segment id='4' features='eror;gramatikal;frasa-preposisi;prep0' state='active' correction='berjumpa dengan' parent='15'><segment id='3' features='eror;gramatikal;frasa-verba;vrbafx' state='active' correction='berjumpa' parent='4'>jumpa</segment> <segment id='27' features='eror;gramatikal;frasa-nomina;pron0' state='active' correction='kakek dan nenek saya' parent='15'>kakek</segment> dan <segment id='5' features='eror;ejaan;ejtb' state='active' parent='15'><segment id='7' features='eror;gramatikal;konjungsi;konj0' state='active' correction='nenek serta makan' parent='5'>nenek</segment>. <segment id='6' features='eror;ejaan;ejk' state='active' correction='makan' parent='7'>Makan</segment></segment></segment> <segment id='30' features='eror;leksikal;kata;ktas' state='active' parent='15'>mikan</segment> dan ikan. Saya pergi ke Kyoto untuk <segment id='9' features='eror;gramatikal;frasa-preposisi;prep0' state='active' correction='berjumpa dengan teman' parent='15'>berjumpa teman</segment> <segment id='10' features='eror;gramatikal;frasa-nomina;yg0' state='active' correction='saya yang tinggal' parent='15'>saya tinggal</segment> di <segment id='12' features='eror;ejaan;ejk' state='active' correction='Kyoto' parent='15'>kyoto</segment>.</segment></segment> Teman <segment id='11' features='eror;ejaan;ejsp' state='active' correction='saya lebih'>sayalebih</segment> pintar dari <segment id='16' features='eror;ejaan;ejsp' state='active' correction='saya. Pergi'>saya.<segment id='17' features='eror;gramatikal;kalimat;kalsub' state='active' correction='Saya berada di Kyoto selama tiga minggu'><segment id='13' features='eror;leksikal;kata;vrbs' state='active' parent='17'>Pergi</segment></segment> <segment id='31' features='eror;leksikal;kata;preps' state='active' parent='17'>ke</segment> <segment id='14' features='eror;ejaan;ejk' state='active' correction='Kyoto' parent='17'>kyoto</segment> tiga minggu</segment>. <segment id='19' features='eror;ejaan;ejsp' state='active'><segment id='18' features='eror;leksikal;kata;prons' state='active' correction='saya' parent='19'>Kita</segment>  makan</segment> <segment id='20' features='eror;gramatikal;frasa-nomina;urtfn' state='active' correction='makanan enak'>enak <segment id='21' features='eror;ejaan;ejtb' state='active'><segment id='22' features='eror;gramatikal;konjungsi;konj0' state='active' correction='enak dan pergi' parent='21'>makanan</segment>, pergi</segment></segment> ke Kiyomizudera dan <segment id='23' features='eror;ejaan;ejhrf' state='active' correction='kinkakuji'><segment id='24' features='eror;ejaan;ejk' state='active' correction='Kinkakuji' parent='23'>kinkakuzi</segment></segment>. Saya mau melihat <segment id='25' features='eror;ejaan;ejhrf' state='active' correction='shugakuin'><segment id='26' features='eror;ejaan;ejk' state='active' correction='Shugakuin' parent='25'>syuugakuin</segment></segment> tahun depan.    </body>
