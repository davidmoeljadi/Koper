<segment id='19' features='eror;gramatikal;kalimat;kalpen' state='active'>[NAMA] <segment id='15' features='eror;ejaan;ejhrf' state='active' parent='19'>bekerjua</segment> di <segment id='17' features='eror;ejaan;ejsp' state='active' parent='19'><segment id='16' features='eror;ejaan;ejhrf' state='active' parent='17'>Shizuika</segment>.[NAMA]</segment> <segment id='18' features='eror;ejaan;ejk' state='active' parent='19'>Ibu</segment> rumah tangga.</segment>
