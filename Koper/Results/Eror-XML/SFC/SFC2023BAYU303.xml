Salah satu film kesukaanku adalah Peminjam Arrietty. <segment id='2' features='eror;gramatikal;frasa-nomina;nom0' state='active' correction='Film ini'>Ini</segment> <segment id='4' features='eror;gramatikal;frasa-preposisi;prep0' state='active' correction='tentang'><segment id='3' features='eror;gramatikal;frasa-verba;vrbafx' state='active' correction='bercerita' parent='4'>cerita</segment> <segment id='1' features='eror;ejaan;ejhrf' state='active' correction='kurcaci-kurcaci' parent='4'>kurcaci-kurcari</segment></segment> yang meminjam berbagai kebutuhan hidup dari manusia <segment id='15' features='eror;gramatikal;frasa-verba;vrb0' state='active' correction='berusaha'><segment id='14' features='eror;leksikal;kata;konjs' state='active' correction='dan' parent='15'>agar</segment> tidak</segment> ditemukan. Arietty <segment id='7' features='eror;gramatikal;frasa-nomina;ygx' state='active'>yang</segment> sebagai peran <segment id='5' features='eror;gramatikal;frasa-verba;vrb0' state='active' correction='berkarakter'>utama kuat</segment> dan <segment id='6' features='eror;gramatikal;frasa-adjektiva;adjj' state='active' correction='imut'>imut-imut</segment>. Aku bisa <segment id='8' features='eror;gramatikal;frasa-verba;vrbafx' state='active' correction='merasakan'>terasa</segment> <segment id='16' features='eror;gramatikal;frasa-nomina;nomafx' state='active' correction='kehidupan'>hidup</segment> yang <segment id='17' features='eror;leksikal;kata;negs' state='active' correction='tidak'>bukan</segment> biasa dari cerita <segment id='18' features='eror;ejaan;ejtb' state='active'>ini <segment id='19' features='eror;gramatikal;kalimat;kalsub' state='active'>jadi</segment> <segment id='20' features='eror;gramatikal;kalimat;kalobj' state='active' parent='19'>suka</segment></segment>. Selain itu, <segment id='9' features='eror;gramatikal;frasa-verba;urtfv' state='active' correction='juga suka sekali musik latarnya.'>musik latar <segment id='10' features='eror;gramatikal;frasa-nomina;nya0' state='active' parent='9'>belakang</segment> <segment id='21' features='eror;gramatikal;kalimat;kalsub' state='active' parent='9'>juga suka sekali</segment>.</segment> Aku pikir <segment id='13' features='eror;gramatikal;konjungsi;konjx' state='active'>bahwa</segment> musiknya <segment id='22' features='eror;gramatikal;frasa-adjektiva;urtfaj' state='active'>mirip <segment id='11' features='eror;gramatikal;frasa-preposisi;prep0' state='active'>sedikit</segment> musik</segment> Bali.(tautan: https://www.ghibli.jp/karigurashi/film_story.html)    </body>
